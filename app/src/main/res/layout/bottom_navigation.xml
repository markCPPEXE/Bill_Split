<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="#FFFFFF"
    android:baselineAligned="false"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Home"
            android:src="@drawable/icons8_home_50"
            app:tint="#6B7280" />

        <TextView
            android:id="@+id/txtNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Home"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Blue '+' Action -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navSplit"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:contentDescription="Split"
            android:focusable="true"
            app:cardBackgroundColor="#2962FF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgNavSplit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Add bill"
                android:src="@drawable/icons8_plus_50"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- History -->
    <LinearLayout
        android:id="@+id/navHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgNavHistory"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="History"
            android:src="@drawable/icons8_history_50"
            app:tint="#6B7280" />

        <TextView
            android:id="@+id/txtNavHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="History"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
