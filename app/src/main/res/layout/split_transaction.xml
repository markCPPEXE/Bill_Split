<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEEEEE">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="22dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="58dp"
            android:fontFamily="@font/azeretmono_bold"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="Bill split"
            android:textColor="#1777F2"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Profile"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- WHITE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="Biller :"
                            android:textColor="#888888"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/edtBiller"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#1777F2"
                            android:fontFamily="monospace"
                            android:hint="e.g. Jollibee"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#BBBBBB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLength="30"
                            android:imeOptions="actionNext" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="Split in to :"
                            android:textColor="#888888"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/edtSplitPeople"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#1777F2"
                            android:fontFamily="monospace"
                            android:hint="e.g. 3"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#BBBBBB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLength="3"
                            android:imeOptions="actionNext" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="Total amount :"
                            android:textColor="#888888"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/edtTotalAmount"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#1777F2"
                            android:fontFamily="monospace"
                            android:hint="e.g. 599"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:textColor="#111111"
                            android:textColorHint="#BBBBBB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLength="12"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="Split amount :"
                            android:textColor="#888888"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtSplitAmount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:paddingStart="4dp"
                            android:text="₱0.00"
                            android:textColor="#111111"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SPLIT BUTTON -->
                    <Button
                        android:id="@+id/btnSplit"
                        android:layout_width="150dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#1877F2"
                        android:fontFamily="monospace"
                        android:stateListAnimator="@null"
                        android:text="Split!"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7C5C5"/>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="19dp"
            android:src="@drawable/icons8_home_50"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/navSplit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="19dp"
            android:src="@drawable/icons8_add_new_blue"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Split"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:src="@drawable/icons8_history_50"
            android:contentDescription="History"
            android:focusable="true"
            android:padding="19dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

</LinearLayout>