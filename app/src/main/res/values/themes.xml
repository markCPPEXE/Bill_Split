<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Bsplit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="fontFamily">@font/plus_jakarta_sans_family</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_family</item>
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="RoundedInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/color_primary_focused</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DangerButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_error</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CancelButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_btn_cancel</item>
        <item name="android:textColor">@color/text_dark_slate</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Bsplit" parent="Base.Theme.Bsplit" />
</resources>
